@startuml Diagramme_Cas_Utilisation
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2E86C1
  FontSize 13
}
skinparam actor {
  BackgroundColor #D5F5E3
  BorderColor #1E8449
  FontSize 13
  FontStyle bold
}
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #2C3E50
skinparam linetype ortho

title Diagramme des Cas d'Utilisation\nPlateforme de Gestion Pédagogique — ISTA Hay Salam

' ─── Acteurs ───────────────────────────────────────────────────────────
actor "Directeur"       as DIR
actor "Coordinateur\n(Pôle)"  as POL
actor "Formateur"       as FOR
actor "Stagiaire"       as STA

' ─── Frontière du système ───────────────────────────────────────────────
rectangle "Plateforme de Gestion Pédagogique — ISTA Hay Salam" {

  ' ──── Authentification ────────────────────────────────────────────────
  package "Authentification" #FEF9E7 {
    usecase "Se connecter"       as UC_LOGIN
    usecase "Se déconnecter"     as UC_LOGOUT
  }

  ' ──── Administration ──────────────────────────────────────────────────
  package "Administration (Directeur)" #EBF5FB {
    usecase "Consulter le tableau de bord"         as UC_DASH
    usecase "Gérer les utilisateurs"               as UC_USERS
    usecase "Gérer les formateurs"                 as UC_FORM
    usecase "Gérer les secteurs"                   as UC_SECT
    usecase "Gérer les filières"                   as UC_FIL
    usecase "Gérer les groupes"                    as UC_GRP
    usecase "Gérer les modules"                    as UC_MOD
    usecase "Gérer les salles"                     as UC_SALL
    usecase "Affecter un coordinateur à un secteur" as UC_POLE
    usecase "Consulter les alertes pédagogiques"   as UC_ALERT
    usecase "Consulter le suivi journalier"        as UC_SUIVI
    usecase "Générer le calendrier académique"     as UC_CAL
    usecase "Importer des données (Excel)"         as UC_IMPORT
  }

  ' ──── Coordination pédagogique ────────────────────────────────────────
  package "Coordination pédagogique (Pôle)" #E9F7EF {
    usecase "Gérer les plannings de modules"                  as UC_PLAN
    usecase "Distribuer automatiquement les heures"           as UC_AUTO
    usecase "Créer l'emploi du temps d'un groupe"             as UC_EDT_G
    usecase "Créer l'emploi du temps d'un formateur"          as UC_EDT_F
    usecase "Gérer les absences des formateurs"               as UC_ABS
    usecase "Consulter les salles disponibles"                as UC_DISP
    usecase "Gérer les stages"                                as UC_STAGE
    usecase "Imprimer les documents OFPPT"                    as UC_PRINT
  }

  ' ──── Espace formateur ────────────────────────────────────────────────
  package "Espace Formateur" #F9EBEA {
    usecase "Consulter son planning personnel"       as UC_FPLAN
    usecase "Consulter son emploi du temps"          as UC_FEDT
  }

  ' ──── Espace stagiaire (public) ───────────────────────────────────────
  package "Espace Stagiaire (accès public)" #F5EEF8 {
    usecase "Consulter l'emploi du temps du groupe"   as UC_SEDT
    usecase "Consulter les modules du groupe"         as UC_SMOD
    usecase "Consulter les stages du groupe"          as UC_SSTG
  }

  ' ──── Relations include / extend ──────────────────────────────────────
  UC_AUTO    .> UC_PLAN   : <<include>>
  UC_EDT_G   .> UC_DISP   : <<include>>
  UC_EDT_F   .> UC_DISP   : <<include>>
  UC_IMPORT  .> UC_USERS  : <<extend>>
}

' ─── Associations acteurs ─────────────────────────────────────────────────
DIR --> UC_LOGIN
DIR --> UC_LOGOUT
DIR --> UC_DASH
DIR --> UC_USERS
DIR --> UC_FORM
DIR --> UC_SECT
DIR --> UC_FIL
DIR --> UC_GRP
DIR --> UC_MOD
DIR --> UC_SALL
DIR --> UC_POLE
DIR --> UC_ALERT
DIR --> UC_SUIVI
DIR --> UC_CAL
DIR --> UC_IMPORT

POL --> UC_LOGIN
POL --> UC_LOGOUT
POL --> UC_PLAN
POL --> UC_EDT_G
POL --> UC_EDT_F
POL --> UC_ABS
POL --> UC_DISP
POL --> UC_STAGE
POL --> UC_PRINT

FOR --> UC_LOGIN
FOR --> UC_LOGOUT
FOR --> UC_FPLAN
FOR --> UC_FEDT

STA --> UC_SEDT
STA --> UC_SMOD
STA --> UC_SSTG

@enduml
